<?xml version="1.0" encoding="utf-8"?>
<!--
  Dispatch's update feed.

  An installed copy of Dispatch polls this file and nothing else — the URL is
  compiled into every build as SUFeedURL and cannot be changed for an app already
  on someone's Mac. So this address is permanent, and this repo must stay PUBLIC:
  Sparkle reads it with no credentials.

  Every entry needs: sparkle:version (the MONOTONIC CFBundleVersion integer, not
  the marketing string — Sparkle compares that one), sparkle:shortVersionString
  (what the customer sees), an enclosure url, length in bytes, and
  sparkle:edSignature produced by bin/sign_update. An entry without a valid
  signature is refused by every installed copy, which is the point.

  The enclosure is the .dmg — the same file a person downloads by hand, so there
  is exactly one artifact to sign, notarize and keep straight.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Dispatch</title>
    <link>https://raw.githubusercontent.com/broodingjay/dispatch-releases/main/appcast.xml</link>
    <description>Updates for Dispatch, a markdown writing app for macOS.</description>
